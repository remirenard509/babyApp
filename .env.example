# =================================================================
# MODÈLE DE VARIABLES D'ENVIRONNEMENT (À COPIER DANS .env OU VERCEL)
# =================================================================

# Chaîne de connexion Supabase (Project Settings > Database > Connection Pooling > Session/Transaction)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Clé secrète pour signer les JWT
SECRET_KEY=votre_cle_secrete_jwt

# Configuration Supabase Storage (Project Settings > API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key
SUPABASE_BUCKET=uploads

